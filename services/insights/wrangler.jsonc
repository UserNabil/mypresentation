{
  "name": "nabil-portfolio-insights",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://usernabil.github.io,https://cv.my-officeapps.com"
  },
